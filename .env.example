# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed template.

# ── Server-side only: used by scripts/ to build and configure the index ──
# The admin key can write and delete. It must never reach the browser.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=

# ── Browser: Vite inlines anything prefixed with VITE_ into the bundle ──
# The search-only key is the ONLY key that is safe here.
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
VITE_ALGOLIA_INDEX_NAME=restaurants
